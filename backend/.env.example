DJANGO_SECRET_KEY=change-this-in-production
# DEBUG must be False on any host reachable from the internet. Only set True
# on your own local machine.
DEBUG=True
# DEV_STATIC_OTP is a LOCAL-DEV-ONLY escape hatch ("123456"). It is honored
# ONLY when DEBUG=True as well, so it can never activate on a reachable
# production server even if left on by mistake — production always requires
# the real emailed OTP. Keep it False everywhere except your own machine.
DEV_STATIC_OTP=False
# Comma-separated hostnames this backend will serve. In production this MUST
# include your backend's public domain (e.g. edunova-cr-ax7h.onrender.com) or
# Django rejects every request with 400 DisallowedHost. settings.py warns at
# startup if this is still the local default in a non-DEBUG environment.
ALLOWED_HOSTS=localhost,127.0.0.1,edunova-cr-ax7h.onrender.com

# Supabase Dashboard > Project Settings > Database > Connection string > Pooler
# IMPORTANT: use the POOLER host (aws-0-<REGION>.pooler.supabase.com, port 5432
# session mode). The DIRECT host (db.<PROJECT-REF>.supabase.co) is IPv6-only for
# new Supabase projects and cannot be reached from Render/Railway/Heroku (no
# IPv6 egress), which makes the backend return 502 and login fail. The pooler
# user is postgres.<PROJECT-REF>.
# Prefer the transaction-mode pooler (port 6543): session mode on 5432 caps
# at 15 persistent connections and exhausts under load.
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres
DB_SSL_REQUIRE=True

# Frontend origins allowed to call this API (comma-separated). settings.py reads
# this env var; when unset it defaults to https://edunova-school-iumy.vercel.app
# (+ localhost:5173 when DEBUG=True). List every deployed frontend domain here.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://edunova-school-iumy.vercel.app
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://edunova-school-iumy.vercel.app

# Supabase Storage/API - server only, do not put service role key in frontend
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Encryption key for `python manage.py backup_database`
BACKUP_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Upload validation (optional, sensible defaults)
# ---------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=20

# ---------------------------------------------------------------------------
# Logging (optional)
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
# LOG_FILE=/var/log/edunova.log

# ---------------------------------------------------------------------------
# Production TLS hardening (defaults to ON when DEBUG=False; set to False to
# override if the TLS termination happens further out in the CDN).
# ---------------------------------------------------------------------------
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000

# ---------------------------------------------------------------------------
# SMTP Email Configuration
# OTP login codes are delivered via email. Configure one of the providers below.
# ---------------------------------------------------------------------------

# --- Option 1: Console backend (development — prints email to terminal) ---
# Primary OTP email path: Brevo HTTPS API (works from Render; SMTP port 587
# is blocked there). Get the key from Brevo -> SMTP & API.
BREVO_API_KEY=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Optional SMTP fallback (used only when BREVO_API_KEY is unset). EMAIL_HOST_USER
# must be the SMTP relay login (b157b5001@smtp-brevo.com), NOT the dashboard login.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@edunovaacademy.edu.in
# Set in production to share the response cache + OTP/throttle counters across
# all gunicorn workers (e.g. Upstash or Render Redis). Falls back to LocMemCache.
REDIS_URL=

# --- Option 2: Gmail (production) ---
# 1. Enable 2-Step Verification on your Google account
# 2. Go to Google Account > Security > App Passwords
# 3. Generate an App Password for "Mail"
# 4. Use that 16-character password as EMAIL_HOST_PASSWORD
#
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your@gmail.com
# EMAIL_HOST_PASSWORD=xxxx-xxxx-xxxx-xxxx
# DEFAULT_FROM_EMAIL=EduNova Academy <your@gmail.com>

# --- Option 3: Brevo (formerly Sendinblue) ---
# Sign up at https://app.brevo.com → SMTP & API → SMTP tab
# 1. Generate a fresh SMTP key (starts with 'xsmtpsib-').
# 2. Verify the sender under Settings > Senders & IPs > Senders.
# 3. CRITICAL for production: under the SMTP key, either disable "Restrict
#    access to the following IPs" or add this server's egress IP (Render
#    web service outbound IP). Otherwise Brevo replies 525 "Unauthorized IP
#    address" and OTP emails fail.
# 4. Verify from the server: python manage.py send_test_email
#
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your@email.com
# EMAIL_HOST_PASSWORD=your-brevo-smtp-key
# DEFAULT_FROM_EMAIL=EduNova Academy <no-reply@yourdomain.com>

# --- Option 4: Mailtrap (safe email testing — never delivers to real inboxes) ---
# Sign up at https://mailtrap.io → Email Testing → SMTP Settings
#
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=sandbox.smtp.mailtrap.io
# EMAIL_PORT=2525
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-mailtrap-user
# EMAIL_HOST_PASSWORD=your-mailtrap-password
# DEFAULT_FROM_EMAIL=no-reply@edunovaacademy.edu.in
